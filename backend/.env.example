# ============ 腾讯云短信（SMS）============
# 控制台：https://console.cloud.tencent.com/smsv2
# 说明：以下 5 项全部填了才会真实下发短信；缺任意一项自动降级为「演示模式」
#      （验证码打印到服务端控制台并回传给前端，方便本地联调）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SMS_SDK_APP_ID=      # 短信控制台 → 应用管理 → SDK AppID
TENCENTCLOUD_SMS_SIGN_NAME=途见旅行  # 需先在控制台申请并通过审核的签名
TENCENTCLOUD_SMS_TEMPLATE_ID=     # 模板形如「验证码{1}，{2}分钟内有效」
TENCENTCLOUD_SMS_REGION=ap-guangzhou
# 联调开关：设为 1 时只打印将要发送的请求体，不真正调用（不扣费）
SMS_DRY_RUN=0

# ============ 邮件（SMTP）============
# 任意 SMTP 均可；腾讯云 SES 也提供 SMTP 地址与账号
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============ 微信 / QQ 开放平台 ============
# 未配置时自动降级为 mock 扫码（输入任意 code 即当作 openid）
# 注意：真实微信/QQ 登录需企业资质，个人开发者通常申请不到
WECHAT_APPID=
WECHAT_SECRET=
QQ_APPID=
QQ_SECRET=
QQ_REDIRECT=

# ============ 其他 ============
JWT_SECRET=                        # 不填则每次启动随机生成（重启后登录态失效）
DEEPSEEK_API_KEY=                  # 配了走真实大模型，未配走规则兜底
BAIDU_MAP_AK=                      # 百度地图 AK，配了走真实 POI 搜索
PORT=3000
